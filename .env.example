APP_NAME=MemPoisonGuard
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

SQLITE_DATABASE_URL=sqlite:///./storage/mempoisonguard.db
CHROMA_PERSIST_DIRECTORY=./storage/chroma

VERIFIED_COLLECTION_NAME=verified_memories
BASELINE_COLLECTION_NAME=baseline_memories
QUARANTINE_COLLECTION_NAME=quarantined_memories

NLI_ENFORCEMENT_DISTANCE_THRESHOLD=0.75
NLI_MODEL_NAME=cross-encoder/nli-distilroberta-base
NLI_CONTRADICTION_THRESHOLD=0.70
NLI_CANDIDATE_LIMIT=5

DUPLICATE_SIMILARITY_THRESHOLD=0.15

HF_HUB_DISABLE_XET=1

FASTAPI_BASE_URL=http://127.0.0.1:8000